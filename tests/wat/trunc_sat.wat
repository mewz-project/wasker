    (call $assert_test_i32 (call $i32.trunc_sat_f32_u (f32.const 1.9)) (i32.const 1))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_u (f32.const 2.0)) (i32.const 2))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_u (f32.const 2147483648)) (i32.const -2147483648))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_u (f32.const 4294967040.0)) (i32.const -256))
