    (call $assert_test_i32 (call $i32.trunc_sat_f32_u (f32.const inf)) (i32.const 0xffffffff))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_u (f32.const -inf)) (i32.const 0x00000000))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_u (f32.const nan)) (i32.const 0))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_u (f32.const nan:0x200000)) (i32.const 0))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_u (f32.const -nan)) (i32.const 0))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_u (f32.const -nan:0x200000)) (i32.const 0))

