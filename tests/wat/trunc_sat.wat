;; Test cases are taken from tests/spec/test/core/conversions.wast
(module
  ;; Import our myprint function
  (import "myenv" "print" (func $print (param i64 i32)))
  ;; Identity functions provided by the wrapper. Passing inputs through them
  ;; prevents LLVM from constant-folding the conversions.
  (import "myenv" "opaque_f32" (func $opaque_f32 (param f32) (result f32)))
  (import "myenv" "opaque_f64" (func $opaque_f64 (param f64) (result f64)))

  ;; Define a single page memory of 64KB.
  (memory $0 1)

  ;; Store the Hello World (null terminated) string at byte offset 0
  (data (i32.const 0) "Test Passed\n")
  (data (i32.const 16) "# Test Failed\n")

  (func $printSuccess
    i64.const 0
    i32.const 12
    (call $print)
  )

  (func $printFail
    i64.const 16
    i32.const 14
    (call $print)
  )
  (func $assert_test_i32 (param $expected i32) (param $result i32)
    local.get $expected
    local.get $result
    i32.eq
    (if
      (then
        (call $printSuccess)
      )
      (else
        (call $printFail)
      )
    )
  )
  (func $assert_test_i64 (param $expected i64) (param $result i64)
    local.get $expected
    local.get $result
    i64.eq
    (if
      (then
        (call $printSuccess)
      )
      (else
        (call $printFail)
      )
    )
  )
  (func $i32.trunc_sat_f32_s (param $x f32) (result i32) (i32.trunc_sat_f32_s (call $opaque_f32 (local.get $x))))
  (func $i32.trunc_sat_f32_u (param $x f32) (result i32) (i32.trunc_sat_f32_u (call $opaque_f32 (local.get $x))))
  (func $i32.trunc_sat_f64_s (param $x f64) (result i32) (i32.trunc_sat_f64_s (call $opaque_f64 (local.get $x))))
  (func $i32.trunc_sat_f64_u (param $x f64) (result i32) (i32.trunc_sat_f64_u (call $opaque_f64 (local.get $x))))
  (func $i64.trunc_sat_f32_s (param $x f32) (result i64) (i64.trunc_sat_f32_s (call $opaque_f32 (local.get $x))))
  (func $i64.trunc_sat_f32_u (param $x f32) (result i64) (i64.trunc_sat_f32_u (call $opaque_f32 (local.get $x))))
  (func $i64.trunc_sat_f64_s (param $x f64) (result i64) (i64.trunc_sat_f64_s (call $opaque_f64 (local.get $x))))
  (func $i64.trunc_sat_f64_u (param $x f64) (result i64) (i64.trunc_sat_f64_u (call $opaque_f64 (local.get $x))))
  (func (export "_start")
    (call $assert_test_i32 (call $i32.trunc_sat_f32_s (f32.const 0.0)) (i32.const 0))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_s (f32.const -0.0)) (i32.const 0))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_s (f32.const 0x1p-149)) (i32.const 0))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_s (f32.const -0x1p-149)) (i32.const 0))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_s (f32.const 1.0)) (i32.const 1))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_s (f32.const 0x1.19999ap+0)) (i32.const 1))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_s (f32.const 1.5)) (i32.const 1))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_s (f32.const -1.0)) (i32.const -1))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_s (f32.const -0x1.19999ap+0)) (i32.const -1))
