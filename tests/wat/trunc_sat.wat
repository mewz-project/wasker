    (call $assert_test_i32 (call $i32.trunc_sat_f64_s (f64.const 0x0.0000000000001p-1022)) (i32.const 0))
    (call $assert_test_i32 (call $i32.trunc_sat_f64_s (f64.const -0x0.0000000000001p-1022)) (i32.const 0))
    (call $assert_test_i32 (call $i32.trunc_sat_f64_s (f64.const 1.0)) (i32.const 1))
    (call $assert_test_i32 (call $i32.trunc_sat_f64_s (f64.const 0x1.199999999999ap+0)) (i32.const 1))
    (call $assert_test_i32 (call $i32.trunc_sat_f64_s (f64.const 1.5)) (i32.const 1))
    (call $assert_test_i32 (call $i32.trunc_sat_f64_s (f64.const -1.0)) (i32.const -1))
    (call $assert_test_i32 (call $i32.trunc_sat_f64_s (f64.const -0x1.199999999999ap+0)) (i32.const -1))
