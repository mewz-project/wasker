    (call $assert_test_i32 (call $i32.trunc_sat_f32_s (f32.const -2.0)) (i32.const -2))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_s (f32.const 2147483520.0)) (i32.const 2147483520))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_s (f32.const -2147483648.0)) (i32.const -2147483648))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_s (f32.const 2147483648.0)) (i32.const 0x7fffffff))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_s (f32.const -2147483904.0)) (i32.const 0x80000000))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_s (f32.const inf)) (i32.const 0x7fffffff))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_s (f32.const -inf)) (i32.const 0x80000000))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_s (f32.const nan)) (i32.const 0))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_s (f32.const nan:0x200000)) (i32.const 0))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_s (f32.const -nan)) (i32.const 0))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_s (f32.const -nan:0x200000)) (i32.const 0))

    (call $assert_test_i32 (call $i32.trunc_sat_f32_u (f32.const 0.0)) (i32.const 0))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_u (f32.const -0.0)) (i32.const 0))
    (call $assert_test_i32 (call $i32.trunc_sat_f32_u (f32.const 0x1p-149)) (i32.const 0))
